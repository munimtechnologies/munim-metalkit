{
  "expo": {
    "name": "Munim MetalKit Example",
    "slug": "munim-metalkit-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sheehanmunim.munimmetalkitexample",
      "appleTeamId": "6T5J6U2UVT"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sheehanmunim.munimmetalkitexample"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
