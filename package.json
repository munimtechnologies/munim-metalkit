{
  "name": "munim-metalkit",
  "version": "3.0.0",
  "description": "Metal compute, custom shaders and a GPU-driven MTKView (MetalFX upscaling, zero-copy buffers) for Expo and React Native on iOS, powered by Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "lint": "eslint src test example/App.tsx example/selftest.ts example/index.ts scripts eslint.config.js release.config.cjs --max-warnings 0",
    "test": "jest",
    "build": "npm run typecheck && bob build",
    "clean": "rm -rf lib android/build android/.cxx",
    "codegen": "nitrogen --logLevel=\"debug\" && node scripts/patch-nitro-optionals.js && node scripts/patch-nitrogen-swift.mjs && node scripts/copy-view-config.js",
    "release": "semantic-release",
    "prepack": "npm run build",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "metal",
    "metalkit",
    "mtkview",
    "gpu",
    "compute",
    "shaders",
    "gpgpu",
    "compute-shaders",
    "metalfx",
    "ios",
    "typescript",
    "nitro",
    "nitro-modules",
    "munim-metalkit",
    "munim-technologies"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "workspaces": [
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-metalkit.git"
  },
  "bugs": {
    "url": "https://github.com/munimtechnologies/munim-metalkit/issues"
  },
  "author": "sheehanmunim <sheehanmunim@gmail.com> (https://github.com/sheehanmunim)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/munimtechnologies/munim-metalkit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "expo": {
    "name": "munim-metalkit",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.88.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.5.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nitrogen": "0.37.2",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.2",
    "semantic-release": "^26.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.2 <1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@semantic-release/npm": {
      "npm": "npm:@semantic-release/error@4.0.0"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false,
    "semi": true
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  }
}
